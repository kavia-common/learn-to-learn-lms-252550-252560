# Public runtime configuration for React (prefix REACT_APP_)
# Base URL of the backend API. For Strapi demo, example:
REACT_APP_API_BASE=https://demo.strapi.io/api

# Optional alternative vars if app references them elsewhere
REACT_APP_BACKEND_URL=
REACT_APP_FRONTEND_URL=
REACT_APP_WS_URL=

# Node env flags
REACT_APP_NODE_ENV=development
REACT_APP_NEXT_TELEMETRY_DISABLED=1
REACT_APP_ENABLE_SOURCE_MAPS=false
REACT_APP_PORT=3000
REACT_APP_TRUST_PROXY=false
REACT_APP_LOG_LEVEL=info

# Feature flags (comma-separated). Enable 'remote' to use Strapi endpoints.
REACT_APP_FEATURE_FLAGS=remote

# Experiments toggle
REACT_APP_EXPERIMENTS_ENABLED=false
