# Frontend configuration
REACT_APP_NODE_ENV=development
REACT_APP_PORT=3000
REACT_APP_ENABLE_SOURCE_MAPS=true
REACT_APP_TRUST_PROXY=false
REACT_APP_LOG_LEVEL=info
REACT_APP_HEALTHCHECK_PATH=/healthz

# Feature flags (comma-separated)
# Include 'remote' to enable remote fetching of categories/courses by default
REACT_APP_FEATURE_FLAGS=remote

# Base URLs
REACT_APP_FRONTEND_URL=http://localhost:3000
REACT_APP_BACKEND_URL=
REACT_APP_WS_URL=

# Strapi demo API base
REACT_APP_API_BASE=https://demo.strapi.io/api

# Experiments
REACT_APP_EXPERIMENTS_ENABLED=false
